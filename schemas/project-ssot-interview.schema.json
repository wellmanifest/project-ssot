{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/project-ssot/interview/v1",
  "title": "Wellmanifest project-ssot interview answers v1",
  "description": "Typed answers that resolve project identity. Placement reuses wellmanifest/new-project intent.placement (HOME / SHAPE / ADOPT / runtimeOwner). Natural language belongs only in declared text fields. Validity never authorizes edits or a live-repo crawl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject_id",
    "name",
    "version",
    "placement",
    "purpose",
    "owners",
    "readme_role",
    "analyzer_present",
    "analyzer_kind",
    "analyzer_noise",
    "human_confirmed_debt"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema": {
      "const": "wellmanifest.project-ssot/interview/v1"
    },
    "subject_id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "placement": {
      "$ref": "#/$defs/placement"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "purpose_authority": {
      "type": "string",
      "maxLength": 80
    },
    "readme_role": {
      "enum": [
        "facade",
        "generated_mirror",
        "allowed_divergence",
        "unknown"
      ]
    },
    "divergence_reason": {
      "type": "string",
      "maxLength": 400
    },
    "analyzer_present": {
      "type": "boolean"
    },
    "analyzer_kind": {
      "enum": [
        "code2llm-toon",
        "map-toon-yaml",
        "redup",
        "other",
        "none"
      ]
    },
    "analyzer_noise": {
      "type": "boolean"
    },
    "human_confirmed_debt": {
      "type": "boolean"
    },
    "capability_verbs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "capability_keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "capability_use_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "capability_do_not_use_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "capability_stacks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "capability_siblings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "capability_install_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "capability_install_package": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "capability_entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "capability_maturity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "home": {
      "enum": [
        "wellmanifest",
        "subactor",
        "semcod"
      ]
    },
    "shape": {
      "enum": [
        "domain_pack",
        "runtime_service",
        "both"
      ]
    },
    "adoptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^wellmanifest/[a-z0-9][a-z0-9-]*$"
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home",
        "shape"
      ],
      "description": "Same object as new-project intent.placement. ADOPT is not HOME. runtime_service must not HOME wellmanifest. runtimeOwner omitted inherits home.",
      "properties": {
        "home": {
          "$ref": "#/$defs/home"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "runtimeOwner": {
          "$ref": "#/$defs/home"
        },
        "adopt": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/adoptId"
          }
        }
      }
    }
  }
}
